<launch>
    <let name="urdf_path"
         value="$(find-pkg-share description)/urdf/main_robot.urdf.xacro" />

    <let name="rviz_config_path"
         value="$(find-pkg-share description)/rviz/Rviz.rviz" />

    <let name="world_path"
         value="$(find-pkg-share bringup)/world/arm.world.sdf" />

    <!-- Gazebo -->
    <executable cmd="gz sim -r $(var world_path)" output="screen" />

    <!-- Gazebo Bridge -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file"
               value="$(find-pkg-share bringup)/config/gazebo_bridge.yaml" />
    </node>

    <!-- Robot State Publisher -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
               value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <!-- RViz -->
    <node pkg="rviz2" exec="rviz2" output="screen"
          args="-d $(var rviz_config_path)" />

    <!-- Spawn Robot -->
    <node pkg="ros_gz_sim" exec="create" output="screen"
          args="-topic robot_description -name robotic_arm -z 0.78" />

    <!-- Controllers -->
    <node pkg="controller_manager" exec="spawner"
          args="joint_state_broadcaster --controller-manager-timeout 60" />

    <node pkg="controller_manager" exec="spawner"
          args="arm_controller --controller-manager-timeout 60" />
</launch>